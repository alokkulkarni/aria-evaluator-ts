// Prisma schema for aria-evaluator-ts
// Run: npm run db:migrate

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BootstrapState {
  id        Int      @id
  createdAt DateTime @default(now())
}

// ─── Tenancy (Phase 0 — dormant scaffolding) ────────────────────────────────────
// One row per customer/tenant. Populated from the control-plane tenant id at SSO
// login (Phase 3). The `tenantId` columns below are nullable and UNENFORCED in
// Phase 0 (the Prisma guard runs in log-only mode); they become required and
// auto-scoped in Phase 3. See docs/MULTI_TENANT_SPEC.md.
model Tenant {
  id         String   @id @default(cuid())
  externalId String?  @unique   // control-plane tenant id (cpUser.tenantId)
  name       String?
  status     String   @default("active") // active|suspended
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

// Shared runtime settings (UI-editable overrides), keyed by the deployment's
// TENANT_ID env ("" for local/non-SaaS). The DB is the source of truth so a
// tenant's autoscaled tasks converge; each task keeps a local file as a fast
// synchronous read cache. Phase 4 of the multi-tenant migration.
model RuntimeSettings {
  tenantId  String   @id
  json      String
  updatedAt DateTime @default(now()) @updatedAt
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  email        String?       @unique
  ssoSubject   String?       @unique
  passwordHash String?       // Phase 1: nullable for OAuth-only users
  // Phase 1: OAuth Integration
  googleSub    String?       @unique
  githubId     Int?          @unique
  microsoftSub String?       @unique
  role         String        @default("admin")
  suspended    Boolean       @default(false)   // GDPR Art. 18 — restriction of processing
  suspendedAt  DateTime?
  lastLoginAt  DateTime?
  sessions     AuthSession[]
  auditLogs    AuditLog[]
  reviews      Review[]
  baselines    Baseline[]
  experiments  Experiment[]
  schedules    Schedule[]
  tenantId     String?       // Phase 0: dormant; required + scoped in Phase 3
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  @@index([tenantId])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ipAddress String?  // Phase 1: capture for audit
  userAgent String?  // Phase 1: capture for audit
  expiresAt DateTime
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tenantId  String?

  @@index([userId])
  @@index([expiresAt])
  @@index([tenantId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  target      String?
  metadataJson String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  tenantId    String?

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([tenantId])
}

// ─── Scenario ─────────────────────────────────────────────────────────────────
model Scenario {
  id          String   @id @default(cuid())
  filePath    String                  // stable key, e.g. "scenario:banking_balance_01"
  sourceRef   String?                 // relative source ref, e.g. "banking/account_query.yaml#0"
  name        String
  channel     String                  // "chat" | "voice"
  description String?
  yamlContent String                  // full YAML text of the scenario block
  owner       String?
  lifecycleStatus String @default("active") // draft|active|deprecated
  contentHash String?
  lastRevisionAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  revisions   ScenarioRevision[]
  runs        Run[]
  baselines   Baseline[]
  experiments Experiment[]
  schedules   Schedule[]
  tenantId    String?

  @@unique([tenantId, filePath])
  @@index([sourceRef])
  @@index([lifecycleStatus])
  @@index([tenantId])
}

model ScenarioRevision {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  sourceRef  String
  yamlContent String
  contentHash String
  source     String   // create|edit|sync
  changedBy  String?
  createdAt  DateTime @default(now())

  @@unique([scenarioId, contentHash])
  @@index([scenarioId, createdAt])
}

// ─── Run ──────────────────────────────────────────────────────────────────────
model Run {
  id           String    @id @default(cuid())
  scenarioId   String?
  scenario     Scenario? @relation(fields: [scenarioId], references: [id])
  scenarioName String
  channel      String
  status       String    @default("pending") // pending|running|completed|failed
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?
  audioPath    String?   // WAV filename under transcripts/audio/ (voice runs)
  job          Job?
  turns        Turn[]
  runEvents    RunEvent[]
  evalResult   EvalResult?
  report       Report?
  experimentRuns ExperimentRun[] @relation("experimentRuns")
  scheduleRuns ScheduleRun[] @relation("scheduleRuns")
  telemetry    RunTelemetry?
  securityAttack SecurityAttack?
  transcripts  TranscriptArtifact[]
  scenarioEvals ScenarioEval[]
  explanations Explanation[]
  scenarioRefsJson String?  // JSON string[] of scenario refs (path#index) — lets "Re-run" reuse the original selection
  tenantId     String?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([scenarioId])
  @@index([createdAt])
  @@index([tenantId])
}

// Per-transcript artifact record so the transcripts listing can be DB-driven (no
// filesystem scan) and any autoscaled instance lists every transcript. The file
// itself lives in the object store. Phase 4 of the multi-tenant migration.
model TranscriptArtifact {
  id           String    @id @default(cuid())
  runId        String
  run          Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  ref          String    // object-store key, e.g. "transcripts/<file>.json"
  scenarioName String
  startedAt    DateTime?
  tenantId     String?
  createdAt    DateTime  @default(now())

  @@unique([runId, ref])
  @@index([runId])
  @@index([createdAt])
  @@index([tenantId])
}

model Job {
  id           String   @id @default(cuid())
  runId        String   @unique
  run          Run      @relation(fields: [runId], references: [id])
  status       String   @default("queued") // queued|running|completed|failed
  payloadJson  String
  attemptCount Int      @default(0)
  workerId     String?
  claimedAt    DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
}

model RunEvent {
  id         Int      @id @default(autoincrement())
  runId      String
  run        Run      @relation(fields: [runId], references: [id])
  eventType  String   // queued|start|log|complete|failed
  payloadJson String
  createdAt  DateTime @default(now())

  @@index([runId, id])
}

// ─── Turn ─────────────────────────────────────────────────────────────────────
model Turn {
  id          String   @id @default(cuid())
  runId       String
  run         Run      @relation(fields: [runId], references: [id])
  index       Int
  role        String   // "customer" | "agent"
  content     String
  durationMs  Int?
  timestampMs BigInt
  createdAt   DateTime @default(now())

  @@index([runId])
}

// ─── EvalResult ───────────────────────────────────────────────────────────────
model EvalResult {
  id              String   @id @default(cuid())
  runId           String   @unique
  run             Run      @relation(fields: [runId], references: [id])
  overallScore    Float
  passed          Boolean
  dimensionScores String   // JSON: Record<string, DimensionScore>
  summary         String
  recommendation  String?
  judgeModel      String
  scenarioType    String?  // 'security' | 'quality'
  judgeTokenInputEstimate  Int?
  judgeTokenOutputEstimate Int?
  judgeTokenTotalEstimate  Int?
  judgeEstimatedCostUsd    Float?   // Estimated judge LLM cost (USD), null if model unknown
  costPricingVersion       Int?     // Pricing registry version used for cost estimate
  securityScore   Float?   // 0–1, separate axis for security runs
  // ── Multi-judge committee (Phase 1) ──────────────────────────────────────
  judgeModels         String?  // JSON array of judge model ids that voted
  judgeAgreement      Float?   // 1 − (mean per-dimension spread / 10); 1 = perfect agreement
  requiresHumanReview Boolean? // true when judges disagreed beyond threshold
  judgeConfigHash     String?  // deterministic hash of the committee config (drift detection)
  createdAt       DateTime @default(now())
  review          Review?

  @@index([passed, createdAt])
  @@index([overallScore])
}

// Per-scenario evaluation within a run. The aggregate EvalResult (one per run)
// drives dashboards; this preserves each scenario's score, dimensions and judge
// votes so a reviewer can inspect/override them individually. Phase 2.
model ScenarioEval {
  id                  String   @id @default(cuid())
  runId               String
  run                 Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  scenarioIndex       Int
  scenarioName        String
  scenarioType        String?  // 'security' | 'quality'
  overallScore        Float
  passed              Boolean
  summary             String?
  dimensionScores     String   // JSON: Record<string, DimensionScore> (incl. judgeVotes)
  judgeModels         String?
  judgeAgreement      Float?
  requiresHumanReview Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@unique([runId, scenarioIndex])
  @@index([runId])
}

// ─── Review ───────────────────────────────────────────────────────────────────
model Review {
  id                     String      @id @default(cuid())
  evalResultId           String      @unique
  evalResult             EvalResult  @relation(fields: [evalResultId], references: [id], onDelete: Cascade)
  runId                  String                  // denormalized for efficient queue queries
  status                 String      @default("pending") // pending|in_review|approved|overridden|rejected
  reviewedBy             String?
  reviewer               User?       @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt             DateTime?
  scoreOverride          Float?                  // 0–10; null = use AI score
  passedOverride         Boolean?                // null = use AI passed
  notes                  String?
  dimensionOverridesJson String?                 // JSON: Record<string, {score: number, notes: string}>
  scenarioOverridesJson  String?                 // JSON: Record<scenarioName, {score?: number, passed?: boolean, dimensions?: Record<string,{score:number}>}>
  queuedAt               DateTime    @default(now())
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @default(now()) @updatedAt

  @@index([runId])
  @@index([status, queuedAt])
  @@index([reviewedBy])
}

// ─── Regression Analysis ──────────────────────────────────────────────────────
model Baseline {
  id                     String   @id @default(cuid())
  name                   String
  scenarioId             String
  scenario               Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  
  // Metrics captured at baseline time
  totalRuns              Int
  passRate               Float
  avgScore               Float
  avgLatencyMs           Int
  
  // Dimension-level metrics (captured at baseline time)
  dimensionIdsJson       String                  // string[] = which dimensions were included
  dimensionMetricsJson   String                  // Record<dimId, {avg: number, stddev: number}>
  
  // Config snapshot
  judgeModel             String
  judgeVersion           Int
  judgeConfigHash        String?                 // committee config hash at baseline time (drift detection)

  // Regression thresholds (configurable)
  thresholdOverridesJson String?                 // {passRateDrop: 5, scoreDrop: 0.5, latencyIncrease: 20}
  
  createdAt              DateTime @default(now())
  createdBy              String?
  user                   User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  notes                  String?
  tenantId               String?

  @@index([scenarioId])
  @@index([createdAt])
  @@index([judgeModel])
  @@index([createdBy])
  @@index([tenantId])
}

// ─── Experiments ──────────────────────────────────────────────────────────────
model Experiment {
  id          String   @id @default(cuid())
  name        String
  scenarioId  String
  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  description String?
  status      String   @default("planning") // planning|running|completed|archived
  createdBy   String?
  user        User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  legs        ExperimentLeg[]
  experimentRuns ExperimentRun[]
  tenantId    String?

  @@index([scenarioId])
  @@index([status])
  @@index([createdBy])
  @@index([tenantId])
}

model ExperimentLeg {
  id             String   @id @default(cuid())
  experimentId   String
  experiment     Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  name           String
  configJson     String   // JSON: {judgeModel, judgeVersion, overrides?, ...}
  description    String?
  targetRunCount Int?
  createdAt      DateTime @default(now())
  experimentRuns ExperimentRun[]

  @@index([experimentId])
}

model ExperimentRun {
  id           String   @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  runId        String   @unique  // global uniqueness: one run per experiment
  run          Run      @relation("experimentRuns", fields: [runId], references: [id], onDelete: Cascade)
  legId        String
  leg          ExperimentLeg @relation(fields: [legId], references: [id], onDelete: Cascade)
  tagsJson     String?  // JSON: string[]
  createdAt    DateTime @default(now())

  @@index([experimentId])
  @@index([legId])
}

// ─── Observability ────────────────────────────────────────────────────────────
model RunTelemetry {
  id                 String   @id @default(cuid())
  runId              String   @unique
  run                Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  provider           String
  channel            String
  status             String   // completed|failed
  latencyMs          Int?
  tokenInputEstimate Int?
  tokenOutputEstimate Int?
  tokenTotalEstimate Int?
  failureClass       String?
  estimatorVersion   Int      @default(1)
  attackCategory     String?  // 'injection'|'evasion'|'exfil'|'policy'|'other' (denorm from SecurityAttack)
  completedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@index([createdAt])
  @@index([completedAt])
  @@index([provider, createdAt])
  @@index([provider, completedAt])
  @@index([failureClass, createdAt])
  @@index([status, createdAt])
  @@index([status, completedAt])
  @@index([attackCategory, createdAt])
}

// ─── Security Attacks ────────────────────────────────────────────────────────────
model SecurityAttack {
  id          String  @id @default(cuid())
  runId       String  @unique
  run         Run     @relation(fields: [runId], references: [id], onDelete: Cascade)

  category    String  // 'injection'|'evasion'|'exfil'|'policy'|'other'
  severity    String  // 'low'|'medium'|'high'|'critical'
  confidence  Float   @default(0.5) // 0–1: heuristic confidence or judge-assigned
  inferred    Boolean @default(true) // true=heuristic, false=explicit in scenario YAML

  target      String? // e.g. "system_prompt", "input_validation", null if broad attack
  notes       String? // high-level description (NOT payloads, NOT PII)

  createdAt   DateTime @default(now())

  @@index([category])
  @@index([severity])
  @@index([createdAt])
}

// ─── Explanations (explainability Phase 2) ─────────────────────────────────────
// On-demand turn-level Shapley attribution for one SESSION/security dimension of
// a run. Computed post-hoc (extra judge calls) and cached here keyed by config
// hash. The attribution payload is small, so it is stored inline as JSON rather
// than in the object store. See src/judge/explain/.
model Explanation {
  id           String   @id @default(cuid())
  runId        String   // DB Run.id
  run          Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  scenarioName String   @default("") // which scenario within the run (multi-scenario runs share a runId)
  dimensionId  String   // which dimension was attributed (e.g. guardrail_compliance)
  method       String   @default("shapley-turn")
  configHash   String   // hash of (model + scenario + dimension + transcript) — cache validity
  data         String   // JSON: TurnShapleyExplanation
  tokensUsed   Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([runId, scenarioName, dimensionId, method])
  @@index([runId])
}

// ─── Report ───────────────────────────────────────────────────────────────────
model Report {
  id        String   @id @default(cuid())
  runId     String   @unique
  run       Run      @relation(fields: [runId], references: [id])
  htmlPath  String   // canonical artifact ref, e.g. reports/report_2026-06-02T21-30-00.html
  jsonPath  String   // canonical artifact ref, e.g. reports/report_2026-06-02T21-30-00.json
  createdAt DateTime @default(now())
}

// ─── Schedules ────────────────────────────────────────────────────────────────
model Schedule {
  id                String   @id @default(cuid())
  name              String
  description       String?
  status            String   @default("active") // active|paused|archived
  createdBy         String
  user              User     @relation(fields: [createdBy], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  deletedAt         DateTime?

  // Scheduling config
  frequency         String   // hourly|daily|weekly|monthly
  cronExpression    String?  // optional cron for power users
  dayOfWeek         Int?     // 0-6 for weekly (0=Sunday)
  hour              Int      // 0-23
  minute            Int      // 0-59
  timezone          String   @default("America/New_York") // IANA timezone

  // Run config
  scenarioId        String?  // FK Scenario.id, NULL = all active
  scenario          Scenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  scenarioFile      String?  // path#index alternative
  provider          String   @default("connect")
  channel           String   @default("chat") // chat|voice
  customMetadata    String?  // JSON: arbitrary config

  // Execution tracking
  lastRunAt         DateTime?
  nextRunAt         DateTime // computed: now + frequency
  lastStatus        String?  // pending|completed|failed
  failureCount      Int      @default(0)
  maxFailures       Int      @default(5)

  scheduleRuns      ScheduleRun[]
  tenantId          String?

  @@unique([tenantId, name])
  @@index([createdBy, status])
  @@index([nextRunAt, status])
  @@index([status])
  @@index([tenantId])
}

model ScheduleRun {
  id        String   @id @default(cuid())
  scheduleId String
  schedule  Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  runId     String
  run       Run      @relation("scheduleRuns", fields: [runId], references: [id], onDelete: Cascade)
  triggeredAt DateTime @default(now())
  status    String   @default("queued") // queued|running|completed|failed
  completedAt DateTime?
  errorMessage String?
  createdAt DateTime @default(now())

  @@index([scheduleId, triggeredAt])
  @@index([runId])
}

// ─── Calibration (Phase 3) ──────────────────────────────────────────────────────
// Human ground-truth labels + per-judge agreement (Cohen's κ) against them.

model CalibrationDataset {
  id          String   @id @default(cuid())
  name        String
  description String?
  source      String   @default("manual") // manual|import|review
  createdAt   DateTime @default(now())
  createdBy   String?

  labels        CalibrationLabel[]
  calibrations  JudgeCalibration[]
  tenantId      String?

  @@index([createdAt])
  @@index([tenantId])
}

model CalibrationLabel {
  id          String              @id @default(cuid())
  datasetId   String?
  dataset     CalibrationDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  source      String              // review|import|manual
  runId       String              // run whose EvalResult.dimensionScores carries the judge votes
  dimensionId String
  humanScore  Float               // 0–10 ground-truth score
  labeledBy   String?
  notes       String?
  createdAt   DateTime            @default(now())

  @@unique([runId, dimensionId, source])
  @@index([datasetId])
  @@index([runId])
  @@index([dimensionId])
}

model JudgeCalibration {
  id            String   @id @default(cuid())
  judgeProvider String
  judgeModelId  String
  dimensionId   String?  // null = overall across dimensions
  datasetId     String?
  dataset       CalibrationDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  sampleCount   Int
  weightedKappa Float
  binaryKappa   Float?
  withinOneRate Float
  exactAgreement Float
  meanAbsError  Float
  trust         String   // trusted|supplementary|blocked|insufficient
  computedAt    DateTime @default(now())

  @@unique([judgeModelId, dimensionId, datasetId])
  @@index([judgeModelId])
  @@index([trust])
}

// ── Pairwise calibration (e.g. LMSYS Chatbot Arena) ──────────────────────────
// Human PAIRWISE preference data (response A vs B). Each judge picks a winner;
// we measure agreement with the human vote. Distinct from the absolute
// per-dimension κ above.

model PairwiseDataset {
  id          String   @id @default(cuid())
  name        String
  description String?
  source      String   @default("import") // lmsys-arena|import
  createdAt   DateTime @default(now())
  createdBy   String?

  items        PairwiseItem[]
  calibrations PairwiseCalibration[]

  @@index([createdAt])
}

model PairwiseItem {
  id          String   @id @default(cuid())
  datasetId   String
  dataset     PairwiseDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  prompt      String
  responseA   String
  responseB   String
  humanWinner String   // A|B|tie
  modelA      String?
  modelB      String?
  language    String?
  createdAt   DateTime @default(now())

  verdicts PairwiseVerdict[]

  @@index([datasetId])
}

model PairwiseVerdict {
  id            String   @id @default(cuid())
  itemId        String
  item          PairwiseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  judgeProvider String
  judgeModelId  String
  preferred     String   // A|B|tie
  reason        String?
  createdAt     DateTime @default(now())

  @@unique([itemId, judgeModelId])
  @@index([itemId])
}

model PairwiseCalibration {
  id                String   @id @default(cuid())
  judgeProvider     String
  judgeModelId      String
  datasetId         String
  dataset           PairwiseDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  sampleCount       Int
  agreementAccuracy Float
  binaryKappa       Float
  tieRate           Float
  computedAt        DateTime @default(now())

  @@unique([judgeModelId, datasetId])
  @@index([judgeModelId])
}

# ── Local docker-compose stack — terraform.tfvars ────────────────────────────
# `terraform apply` brings up the whole local stack (app + PostgreSQL + Redis)
# via the repo-root docker-compose.yml:
#
#   cp terraform.tfvars.example terraform.tfvars
#   terraform init
#   terraform apply        # app at http://localhost:3001
#
# Most config (AWS region, token secrets, optional judge provider keys) lives in
# the repo-root `.env` — copy it from `.env.example`. docker compose loads it
# automatically; you usually don't need to set anything here.
#
# First login: a default admin user is auto-created; its password is printed to
# the app logs:
#   docker compose logs aria-evaluator | grep -A4 "default admin"
#
# AWS credentials: the judge runs on Amazon Bedrock and reads your host ~/.aws
# (mounted read-only). Run `aws configure` or `aws sso login` first, and make
# sure you have Bedrock model access in `aws_region`.
#
# Tear down:  terraform destroy   (add `docker compose down -v` to wipe volumes)
# ─────────────────────────────────────────────────────────────────────────────

aws_region = "eu-west-2"

# Set true to also start the local Bedrock proxy container so the app can call
# Bedrock via a local HTTP proxy (docker compose --profile bedrock).
enable_bedrock_proxy = false

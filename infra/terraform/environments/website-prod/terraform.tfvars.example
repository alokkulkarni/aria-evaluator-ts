# ── Website Production Deployment (Static S3 + CloudFront) ─────────────────────
# Copy this file to terraform.tfvars and fill in real values before deploying.
#
# Architecture:
#   CloudFront (ariaeval.io)
#   ├── /* (default)     → S3 bucket (static website export)
#   └── /_next/static/*  → S3 bucket (long-cached assets)

# ── Deploy Steps ──────────────────────────────────────────────────────────────
#
# The website build, S3 sync, and CloudFront invalidation all happen
# automatically during `terraform apply`. No manual aws commands needed.
#
#   cd infra/terraform/environments/website-prod
#   cp terraform.tfvars.example terraform.tfvars   # fill in values
#   terraform init
#   terraform apply
#
# To force a website rebuild and redeploy:
#   terraform apply -var='force_rebuild=2'

# ── Domain & TLS ──────────────────────────────────────────────────────────────
# 1. Register domain in Route53 (already done: ariaeval.io)
# 2. Get the Hosted Zone ID from Route53 console
# 3. Request ACM cert in us-east-1 (for CloudFront + WAF)
#    - Domain: ariaeval.io  SANs: *.ariaeval.io
# 4. Validate cert via DNS (Route53 auto-validation)

domain_name                   = "ariaeval.io"
route53_zone_id               = ""    # e.g. "Z0123456789ABCDEFGHIJ"
acm_certificate_arn_us_east_1 = "" # e.g. "arn:aws:acm:us-east-1:ACCOUNT:certificate/UUID"

# ── SEO / Analytics ───────────────────────────────────────────────────────────
# Google Search Console: the apex `google-site-verification` TXT record already
# exists and is adopted into Terraform (variable `google_site_verification_txt`
# has the live token as its default). One-time, after first apply, import it:
#   terraform import 'aws_route53_record.google_site_verification[0]' \
#     '<route53_zone_id>_ariaeval.io_TXT'
#
# GA4: set the Measurement ID to turn on analytics (Consent Mode v2 default-denied
# until a consent banner grants it). Leave empty to keep analytics off.
# ga4_measurement_id = "G-XXXXXXXXXX"
#
# The seo-google API key + service-account JSON live in Secrets Manager
# (/aria/website/prod/seo-google-api), seeded with PENDING_BOOTSTRAP and populated
# out-of-band — never put them in this file.

# ── Notifications ─────────────────────────────────────────────────────────────
# alarm_sns_topic_arn = "arn:aws:sns:eu-west-2:ACCOUNT:aria-alarms"

# ── CloudTrail ────────────────────────────────────────────────────────────────
# cloudtrail_bucket_suffix = "prod"
# cloudtrail_kms_key_arn   = ""

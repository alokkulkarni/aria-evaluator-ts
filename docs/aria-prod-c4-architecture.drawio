<mxfile host="app.diagrams.net">
  <diagram name="L1 — System Context" id="c4-l1-context">
    <mxGraphModel dx="1024" dy="720" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1050" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="l1-title" value="ARIA Evaluator — C4 Level 1: System Context" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#0B2A4A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l1-legend" value="&lt;b&gt;Legend&lt;/b&gt;&#10;● Person   ▣ ARIA system (in scope)   ▢ External system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B8C4;fontColor=#444444;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1120" y="20" width="350" height="56" as="geometry" />
        </mxCell>
        <mxCell id="l1-person" value="&lt;b&gt;Platform User&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Tenant admin / evaluator who runs scenarios and reviews AI safety &amp; quality reports" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l1-system" value="&lt;b&gt;ARIA Evaluator Platform&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Tests conversational AI agents: runs scenarios, captures transcripts, scores them across 15 dimensions with an LLM judge, and checks security &amp; compliance. Multi-tenant SaaS." style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#1061A0;strokeColor=#0B4C80;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="410" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="l1-cognito" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;User pool + Google / Apple identity federation" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="430" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="l1-bedrock" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Claude judge models (us-east-1 cross-region inference)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1140" y="300" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="l1-llm" value="&lt;b&gt;External LLM APIs&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;OpenAI · Azure OpenAI · Anthropic · Google Gemini (judge / agent models)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1140" y="470" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="l1-targets" value="&lt;b&gt;Conversational AI Targets&lt;/b&gt;&lt;br&gt;[External Systems Under Test]&lt;br&gt;&lt;br&gt;Amazon Connect · Lex · Azure Bot · OpenAPI / Custom agents" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#8E8E8E;strokeColor=#6B6B6B;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="770" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="l1-voice" value="&lt;b&gt;Voice Services&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Amazon Polly (TTS) + Transcribe (STT)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="770" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="l1-ses" value="&lt;b&gt;Amazon SES&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Transactional / account emails" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="780" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l1-e1" value="Runs evaluations, reviews reports [HTTPS]" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="l1-person" target="l1-system">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l1-e2" value="Authenticates users via" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="l1-system" target="l1-cognito">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l1-e3" value="Scores transcripts via Claude judge" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="l1-system" target="l1-bedrock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l1-e4" value="Scores / drives turns via" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="l1-system" target="l1-llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l1-e5" value="Runs scenarios against (under test)" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="l1-system" target="l1-targets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l1-e6" value="Synthesizes / transcribes speech via" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="l1-system" target="l1-voice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l1-e7" value="Sends account emails via" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="l1-system" target="l1-ses">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="L2 — Container" id="c4-l2-container">
    <mxGraphModel dx="1024" dy="720" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="ARIA Evaluator — C4 Level 2: Container Diagram (eu-west-2)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#0B2A4A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&#10;● Person  ·  ▣ Internal container  ·  ▢ External system (grey)&#10;Dashed boundary = ARIA Evaluator platform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B8C4;fontColor=#444444;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1540" y="20" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="person" value="&lt;b&gt;Platform User&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Tenant admin / evaluator who runs scenarios and reviews AI safety &amp; quality reports" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="boundary" value="ARIA Evaluator Platform [Software System]" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#3C7FC0;fontColor=#3C7FC0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontStyle=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="120" y="250" width="1240" height="900" as="geometry" />
        </mxCell>
        <mxCell id="c-frontend" value="&lt;b&gt;Marketing Site &amp; App Shell&lt;/b&gt;&lt;br&gt;[Container: Next.js static export]&lt;br&gt;&lt;br&gt;ariaeval.io public site + SPA shell. Served from S3 via CloudFront (OAC, WAF)." style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="300" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-auth" value="&lt;b&gt;Auth Service&lt;/b&gt;&lt;br&gt;[Container: NextAuth · ECS Fargate]&lt;br&gt;&lt;br&gt;Sign-in, federated SSO and session management. Behind Auth ALB (HTTPS)." style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="500" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-cp" value="&lt;b&gt;Control Plane&lt;/b&gt;&lt;br&gt;[Container: Node.js · ECS Fargate]&lt;br&gt;&lt;br&gt;Tenant provisioning, user management, quotas, SSO-token verification. Internal ALB only." style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="730" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c-cpstate" value="&lt;b&gt;Control Plane State&lt;/b&gt;&lt;br&gt;[Container: DynamoDB]&lt;br&gt;&lt;br&gt;Tenant/user/session state with optimistic-concurrency (CAS). KMS-encrypted." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="950" width="210" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-eval" value="&lt;b&gt;Evaluator API + UI&lt;/b&gt;&lt;br&gt;[Container: Node/Express + React · ECS Fargate]&lt;br&gt;&lt;br&gt;Runs scenarios, conversation runner, LLM-judge scoring across 15 dimensions; serves dashboard, reports &amp; transcripts. Behind public CloudFront → ALB." style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#2E6FB0;strokeColor=#2A6299;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="420" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c-bedrockproxy" value="&lt;b&gt;Bedrock Proxy&lt;/b&gt;&lt;br&gt;[Container: Python Lambda + API Gateway]&lt;br&gt;&lt;br&gt;Signed, CORS-guarded proxy for Bedrock model invocation." style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="680" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-queue" value="&lt;b&gt;Job Queue &amp; Pub/Sub&lt;/b&gt;&lt;br&gt;[Container: ElastiCache Redis]&lt;br&gt;&lt;br&gt;BullMQ run queue + cross-task SSE pub/sub for live progress." style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="300" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-db" value="&lt;b&gt;Evaluation Database&lt;/b&gt;&lt;br&gt;[Container: Aurora PostgreSQL Serverless v2]&lt;br&gt;&lt;br&gt;Tenants, runs, immutable transcripts, eval results (row-level tenant isolation)." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="480" width="210" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ext-cognito" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;User pool + Google / Apple identity federation" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1430" y="500" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ext-bedrock" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Claude judge models (us-east-1 cross-region inference)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1430" y="680" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ext-llm" value="&lt;b&gt;External LLM APIs&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;OpenAI · Azure OpenAI · Anthropic · Google Gemini (judge / agent models)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1430" y="320" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ext-targets" value="&lt;b&gt;Conversational AI Targets&lt;/b&gt;&lt;br&gt;[External Systems Under Test]&lt;br&gt;&lt;br&gt;Amazon Connect · Lex · Azure Bot · OpenAPI / Custom agents" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#8E8E8E;strokeColor=#6B6B6B;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="990" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ext-voice" value="&lt;b&gt;Voice Services&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Amazon Polly (TTS) + Transcribe (STT) for voice scenarios" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="990" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ext-ses" value="&lt;b&gt;Amazon SES&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Transactional / account emails" style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1430" y="950" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="r-user-fe" value="Uses (HTTPS, ariaeval.io)" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="person" target="c-frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r-user-eval" value="Uses app (HTTPS via CloudFront)" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="person" target="c-eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r-fe-auth" value="/api/* sign-in" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="c-frontend" target="c-auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r-auth-cognito" value="Federates auth (OIDC)" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="c-auth" target="ext-cognito">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r-auth-cp" value="Verify SSO token (VPC peering)" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="c-auth" target="c-cp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r-eval-cp" value="Verify SSO token + tenant ctx (VPC peering)" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="c-eval" target="c-cp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r-cp-state" value="Reads / writes (CAS)" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="c-cp" target="c-cpstate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r-cp-ses" value="Sends emails" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="c-cp" target="ext-ses">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r-eval-db" value="Reads / writes (SQL, :5432)" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="c-eval" target="c-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r-eval-queue" value="Enqueue runs + SSE (:6379)" style="endArrow=block;html=1;dashed=1;dashPattern=6 6;strokeColor=#5A6C86;fontColor=#33475B;fontSize=10;rounded=0;" edge="1" parent="1" source="c-eval" target="c-queue">
          <mxGeometry relative="1" as="geometry" />

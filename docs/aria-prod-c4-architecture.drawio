  <diagram name="L4 — Code (Adapter contract)" id="c4-l4-code">
    <mxGraphModel dx="1024" dy="720" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="l4-title" value="ARIA Evaluator — C4 Level 4: Code (Provider Adapter class model · src/adapters)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#0B2A4A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l4-note" value="C4 Level 4 is optional and code-derived. Shown here for the central abstraction — the adapter contract that every conversational-AI provider implements (BaseAdapter). New providers are registered in conversation/runner.ts via normalizeProvider()." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D4A017;fontColor=#5A4500;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1000" height="48" as="geometry" />
        </mxCell>
        <mxCell id="l4-runner" value="&lt;b&gt;ConversationRunner&lt;/b&gt; «class»&#10;────────────────────&#10;+ run(scenario): Transcript&#10;+ normalizeProvider(provider)&#10;# mode: 'script' | 'agent'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#1A2A44;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="l4-base" value="&lt;b&gt;BaseAdapter&lt;/b&gt; «interface»&#10;────────────────────&#10;+ connect(): Promise&lt;void&gt;&#10;+ sendMessage(text): Promise&lt;void&gt;&#10;+ receive(): Promise&lt;AdapterMessage | null&gt;&#10;+ disconnect(): Promise&lt;void&gt;&#10;────────────────────&#10;throws SessionEndedError on close&#10;returns null on timeout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#13351A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="130" width="340" height="200" as="geometry" />
        </mxCell>
        <mxCell id="l4-msg" value="&lt;b&gt;AdapterMessage&lt;/b&gt; «type»&#10;────────────────────&#10;+ from: 'agent' | 'user'&#10;+ text: string&#10;+ raw?: unknown&#10;+ timestamp: number" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#5A3A00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1100" y="130" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="l4-err" value="&lt;b&gt;SessionEndedError&lt;/b&gt; «error»&#10;────────────────────&#10;thrown when the remote&#10;session closes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#5A1A1A;fontSize=11;" vertex="1" parent="1">

  <diagram name="L3 — Component (Evaluator API + UI)" id="c4-l3-component">
    <mxGraphModel dx="1024" dy="720" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="l3-title" value="ARIA Evaluator — C4 Level 3: Component Diagram (Evaluator API + UI container)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#0B2A4A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l3-legend" value="&lt;b&gt;Legend&lt;/b&gt;&#10;▣ Component (in container)   ▢ External container / system&#10;Dashed boundary = Evaluator API + UI container (src/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B8C4;fontColor=#444444;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=10;" vertex="1" parent="1">
